<% if issue.cosmosys_poris? %>
  <div class="box cosmosys-poris-details">
    <h3><%= l(:label_cosmosys_poris_metadata) %></h3>
    <table class="attributes"><tbody>
      <% if issue.pr_src_label.present? %><tr><th><%= l(:field_pr_src_label) %></th><td><%= issue.pr_src_label %></td></tr><% end %>
      <% if issue.cosmosys_poris_value? %>
        <tr><th><%= l(:field_pr_value_kind) %></th><td><%= l("label_cosmosys_poris_#{issue.pr_value_kind}") %></td></tr>
        <% if issue.pr_value_kind == 'float' %>
          <tr><th><%= l(:field_pr_min) %></th><td><%= issue.pr_min || '-' %></td></tr>
          <tr><th><%= l(:field_pr_default) %></th><td><%= issue.pr_default || '-' %></td></tr>
          <tr><th><%= l(:field_pr_max) %></th><td><%= issue.pr_max || '-' %></td></tr>
        <% elsif issue.pr_value_kind == 'text' %>
          <tr><th><%= l(:field_pr_default_text) %></th><td><%= issue.pr_default_text.presence || '-' %></td></tr>
        <% end %>
      <% end %>
    </tbody></table>
  </div>
  <% preview = CosmosysPoris::SpecPreview.new(issue).render %>
  <div class="box cosmosys-poris-spec-preview">
    <h3><%= l(:label_cosmosys_poris_generated_preview) %></h3>
    <div class="splitcontent">
      <section class="splitcontentleft">
        <h4><%= l(:label_cosmosys_poris_requirements_preview) %></h4>
        <div class="wiki"><%= textilizable(preview.requirements_markdown, object: issue, project: issue.project) %></div>
      </section>
      <section class="splitcontentright">
        <h4><%= l(:label_cosmosys_poris_validation_preview) %></h4>
        <div class="wiki"><%= textilizable(preview.validation_markdown, object: issue, project: issue.project) %></div>
      </section>
    </div>
    <p class="help"><%= l(:text_cosmosys_poris_preview_not_saved) %></p>
  </div>
<% end %>

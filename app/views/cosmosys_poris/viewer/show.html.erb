<%= stylesheet_link_tag 'poris_viewer/style.css', plugin: 'cosmosys_poris' %>
<%= stylesheet_link_tag 'poris_project.css', plugin: 'cosmosys_poris' %>

<h2><%= l(:label_cosmosys_poris_project_profile) %>: <%= @project.name %></h2>
<% if @issue %>
  <nav class="poris-view-scopes" aria-label="<%= l(:label_cosmosys_poris_view_scopes) %>">
    <% %w[node project node_down].each do |scope| %>
      <%= link_to l("label_cosmosys_poris_scope_#{scope}"),
                  project_poris_viewer_path(@project, scope: scope, issue_id: @issue.id),
                  class: ('selected' if @scope == scope),
                  aria: { current: (@scope == scope ? 'page' : nil) } %>
    <% end %>
  </nav>
<% end %>
<div class="poris-project-layout<%= ' poris-project-layout-with-diagram' if @combined_diagram_url %>">
  <div class="poris-project-viewer">
    <div id="porisViewer"></div>
  </div>
  <% if @combined_diagram_url %>
    <aside class="poris-project-diagram">
      <% if @runtime_commit_url %>
        <section class="poris-runtime-state" id="porisRuntimeState"
               data-mode-template="<%= l(:text_cosmosys_poris_runtime_mode, name: '%{name}', mode: '%{mode}') %>"
               data-value-template="<%= l(:text_cosmosys_poris_runtime_value, name: '%{name}', value: '%{value}', data: '%{data}') %>"
               data-value-without-data-template="<%= l(:text_cosmosys_poris_runtime_value_without_data, name: '%{name}', value: '%{value}') %>"
               data-rejected-label="<%= l(:text_cosmosys_poris_runtime_operation_rejected) %>">
        <h3><%= l(:label_cosmosys_poris_runtime_state) %></h3>
        <ul class="poris-runtime-nodes" id="porisRuntimeNodes">
          <% Array(@runtime_state).each do |row| %>
            <li><%= l(:text_cosmosys_poris_runtime_mode, name: row['name'], mode: row['mode_name']) %></li>
            <% if row['value_name'] %>
              <li><%= row['data'].nil? ? l(:text_cosmosys_poris_runtime_value_without_data, name: row['name'], value: row['value_name']) : l(:text_cosmosys_poris_runtime_value, name: row['name'], value: row['value_name'], data: row['data']) %></li>
            <% end %>
          <% end %>
        </ul>
        <% if Array(@runtime_state).empty? %>
          <p id="porisRuntimeEmpty"><%= l(:text_cosmosys_poris_runtime_empty) %></p>
        <% end %>
        <h4><%= l(:label_cosmosys_poris_runtime_operations) %></h4>
        <ol class="poris-runtime-operations" id="porisRuntimeOperations"></ol>
        </section>
      <% end %>
      <h3><%= l(:label_cosmosys_project_combined_diagram) %></h3>
      <%= image_tag @combined_diagram_url, alt: l(:label_cosmosys_project_combined_diagram) %>
    </aside>
  <% end %>
</div>

<% if @project_preview %>
  <section class="poris-project-previews">
    <h3><%= l(:label_cosmosys_poris_project_preview) %></h3>
    <p>
      <%= link_to l(:label_cosmosys_poris_generate_datums), project_poris_datum_preflight_path(@project), class: 'button' %>
    </p>
    <div class="splitcontent">
      <section class="splitcontentleft">
        <h4><%= l(:label_cosmosys_poris_requirements_preview) %></h4>
        <div class="wiki"><%= textilizable(@project_preview.requirements_markdown, object: @project, project: @project) %></div>
        <% if @requirements_plugin_installed %>
          <button type="button" class="button poris-generation-ack" data-message="<%= l(:text_cosmosys_poris_preview_ack) %>"><%= l(:label_cosmosys_poris_generate_requirements) %></button>
        <% end %>
      </section>
      <section class="splitcontentright">
        <h4><%= l(:label_cosmosys_poris_validation_preview) %></h4>
        <div class="wiki cosmosys-poris-validation-preview"><%= textilizable(@project_preview.validation_markdown, object: @project, project: @project) %></div>
        <% if @validation_plugin_installed %>
          <button type="button" class="button poris-generation-ack" data-message="<%= l(:text_cosmosys_poris_preview_ack) %>"><%= l(:label_cosmosys_poris_generate_validation) %></button>
        <% end %>
      </section>
    </div>
    <p class="help"><%= l(:text_cosmosys_poris_preview_not_saved) %></p>
    <p class="poris-generation-ack-message" role="status" aria-live="polite"></p>
  </section>
  <script>
    document.querySelectorAll('.poris-generation-ack').forEach((button) => {
      button.addEventListener('click', () => {
        const status = document.querySelector('.poris-generation-ack-message');
        if (status) status.textContent = button.dataset.message;
      });
    });
  </script>
<% end %>

<script type="module">
  import { createPorisViewerPanel } from '<%= asset_path('plugin_assets/cosmosys_poris/poris_viewer/prod.js') %>';
  const initialState = <%= raw json_escape(Array(@runtime_state).to_json) %>;
  const runtimePanel = document.getElementById('porisRuntimeState');
  const interpolate = (template, values) => template.replace(/%\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
  const renderRuntimeResult = (result) => {
    const nodes = document.getElementById('porisRuntimeNodes');
    const operations = document.getElementById('porisRuntimeOperations');
    if (!nodes || !operations) return;
    nodes.replaceChildren();
    operations.replaceChildren();
    document.getElementById('porisRuntimeEmpty')?.remove();
    (result.state || []).forEach((row) => {
      const modeLine = document.createElement('li');
      modeLine.textContent = interpolate(runtimePanel.dataset.modeTemplate, { name: row.name, mode: row.mode_name });
      nodes.appendChild(modeLine);
      if (row.value_name) {
        const valueLine = document.createElement('li');
        const template = row.data == null ? runtimePanel.dataset.valueWithoutDataTemplate : runtimePanel.dataset.valueTemplate;
        valueLine.textContent = interpolate(template, { name: row.name, value: row.value_name, data: row.data });
        nodes.appendChild(valueLine);
      }
    });
    (result.operations || []).forEach((operation) => {
      const line = document.createElement('li');
      line.textContent = operation.accepted ? operation.call : `${operation.call} — ${runtimePanel.dataset.rejectedLabel}: ${operation.reason}`;
      operations.appendChild(line);
    });
  };
  createPorisViewerPanel('<%= j @model_url %>', '#porisViewer', {
    commitUrl: '<%= j(@runtime_commit_url.to_s) %>',
    csrfToken: document.querySelector('meta[name="csrf-token"]')?.content || '',
    initialState,
    onCommit: renderRuntimeResult
  });
</script>
